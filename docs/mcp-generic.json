{
  "_说明": "通用 mcpServers 格式（Claude Code 的 .mcp.json、Cursor 的 .cursor/mcp.json 等）。推荐 clawdata-http（连 109 常驻 MCP 服务）；stdio 三选一备用。Token 在 109 的 config/mcp.json。",
  "mcpServers": {
    "clawdata-http": {
      "type": "http",
      "url": "http://10.168.1.109:8100/mcp",
      "headers": {
        "Authorization": "Bearer <TOKEN：ssh 10.168.1.109 cat ~/project/clawdata/config/mcp.json>"
      }
    },
    "clawdata": {
      "command": "ssh",
      "args": [
        "10.168.1.109",
        "cd ~/project/clawdata && .venv/bin/python -m clawdata.mcp --api http://127.0.0.1:8000"
      ]
    },
    "clawdata-on-109": {
      "command": "/home/applo/project/clawdata/.venv/bin/python",
      "args": ["-m", "clawdata.mcp", "--api", "http://127.0.0.1:8000"],
      "cwd": "/home/applo/project/clawdata"
    },
    "clawdata-win": {
      "command": "D:\\project\\clawdata\\.venv\\Scripts\\python.exe",
      "args": ["-m", "clawdata.mcp", "--api", "http://127.0.0.1:8000"],
      "cwd": "D:\\project\\clawdata"
    }
  }
}
