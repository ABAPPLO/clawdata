{
  "_说明": "ZCode 接入配置。放到 ~/.zcode/cli/config.json（全局）或 <项目>/.zcode/config.json（项目级），与已有 mcp.servers 合并。推荐用 clawdata-http（连 109 常驻 MCP 服务，无需 SSH）；stdio 三选一备用。Token 在 109 的 config/mcp.json。注意 schema 严格，未知字段会导致整个 server 被丢弃。",
  "mcp": {
    "servers": {
      "clawdata-http": {
        "type": "http",
        "url": "http://10.168.1.109:8100/mcp",
        "headers": {
          "Authorization": "Bearer <TOKEN：ssh 10.168.1.109 cat ~/project/clawdata/config/mcp.json>"
        },
        "timeoutMs": 180000
      },
      "clawdata": {
        "type": "stdio",
        "command": "ssh",
        "args": [
          "10.168.1.109",
          "cd ~/project/clawdata && .venv/bin/python -m clawdata.mcp --api http://127.0.0.1:8000"
        ],
        "timeoutMs": 180000
      },
      "clawdata-on-109": {
        "type": "stdio",
        "command": "/home/applo/project/clawdata/.venv/bin/python",
        "args": ["-m", "clawdata.mcp", "--api", "http://127.0.0.1:8000"],
        "cwd": "/home/applo/project/clawdata",
        "timeoutMs": 180000
      },
      "clawdata-win": {
        "type": "stdio",
        "command": "D:\\project\\clawdata\\.venv\\Scripts\\python.exe",
        "args": ["-m", "clawdata.mcp", "--api", "http://127.0.0.1:8000"],
        "cwd": "D:\\project\\clawdata",
        "timeoutMs": 180000
      }
    }
  }
}
