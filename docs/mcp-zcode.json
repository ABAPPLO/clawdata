{
  "_说明": "ZCode 双源接入配置：clawdata-109 = Linux 部署机 clawdata（面板:8000 + MCP:8100，Token 鉴权）；video-share-105 = 105 素材库机自带的视频素材库 MCP（Node 服务 :8000/mcp，免 Token）。放到 ~/.zcode/cli/config.json 或 <项目>/.zcode/config.json，与已有 mcp.servers 合并。",
  "mcp": {
    "servers": {
      "clawdata-109": {
        "type": "http",
        "url": "http://10.168.1.109:8100/mcp",
        "headers": {
          "Authorization": "Bearer r_0SRFCeoRJiLSJDCWbhXIoRLGAIGIFj"
        },
        "timeoutMs": 180000
      },
      "video-share-105": {
        "type": "http",
        "url": "http://10.168.1.105:8000/mcp",
        "timeoutMs": 60000
      },
      "clawdata": {
        "type": "stdio",
        "command": "ssh",
        "args": [
          "10.168.1.109",
          "cd ~/project/clawdata && .venv/bin/python -m clawdata.mcp --api http://127.0.0.1:8000"
        ],
        "timeoutMs": 180000
      },
      "clawdata-on-109": {
        "type": "stdio",
        "command": "/home/applo/project/clawdata/.venv/bin/python",
        "args": ["-m", "clawdata.mcp", "--api", "http://127.0.0.1:8000"],
        "cwd": "/home/applo/project/clawdata",
        "timeoutMs": 180000
      },
      "clawdata-win": {
        "type": "stdio",
        "command": "D:\\project\\clawdata\\.venv\\Scripts\\python.exe",
        "args": ["-m", "clawdata.mcp", "--api", "http://127.0.0.1:8000"],
        "cwd": "D:\\project\\clawdata",
        "timeoutMs": 180000
      }
    }
  }
}
